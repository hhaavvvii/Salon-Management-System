<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.ServicesController"
            prefHeight="700" prefWidth="1000">

    <!-- TOP: Filters -->
    <top>
        <HBox spacing="12" alignment="CENTER" style="-fx-background-color: #f8f6fc;">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <TextField fx:id="searchNameField" promptText="Search by name" prefWidth="180"/>
            <ComboBox fx:id="categoryFilter" promptText="Category" prefWidth="150"/>
            <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="120"/>

            <Button text="Search" onAction="#onSearch"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>
            <Button text="Reset" onAction="#onReset"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CENTER: Services List -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <ListView fx:id="servicesListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <!-- RIGHT: Form -->
    <right>
        <VBox spacing="16" prefWidth="300"
              style="-fx-background-color: #f4f2fa; -fx-padding: 20;">

            <Label fx:id="formTitle"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6f42c1;"/>

            <Separator/>

            <VBox spacing="12">
                <TextField fx:id="nameField" promptText="Service Name"
                           style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <ComboBox fx:id="categoryBox" promptText="Category"
                          style="-fx-background-radius: 8;"/>
                <TextField fx:id="priceField" promptText="Price"
                           style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <Spinner fx:id="durationSpinner" prefWidth="Infinity"/>
                <ComboBox fx:id="statusBox" promptText="Status"
                          style="-fx-background-radius: 8;"/>
            </VBox>

            <Separator/>

            <VBox spacing="10">
                <Button fx:id="saveButton" text="Save"
                        onAction="#onSave" maxWidth="Infinity"
                        style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
                <Button text="Clear" onAction="#onClear"
                        maxWidth="Infinity"
                        style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>
