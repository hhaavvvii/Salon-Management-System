<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.ServicesController"
            prefHeight="700.0" prefWidth="1000.0">

    <!-- Верхняя панель: Фильтры и поиск -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #f8f9fa;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Search:"/>
                <TextField fx:id="searchNameField" promptText="Search by name..." prefWidth="250"/>

                <Label text="Category:"/>
                <ComboBox fx:id="categoryFilter" promptText="All categories" prefWidth="150"/>

                <Label text="Status:"/>
                <ComboBox fx:id="statusFilter" promptText="All statuses" prefWidth="120"/>

                <Button text="Search" onAction="#onSearch"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 5 15;"/>
                <Button text="Reset" onAction="#onReset"
                        style="-fx-padding: 5 15;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Центр: Таблица с услугами -->
    <center>
        <TableView fx:id="servicesTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="200"/>
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="150"/>
                <TableColumn fx:id="priceCol" text="Price (₸)" prefWidth="100"/>
                <TableColumn fx:id="durationCol" text="Duration (min)" prefWidth="120"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Правая панель: Форма добавления/редактирования -->
    <right>
        <VBox spacing="15" prefWidth="320" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="formTitle" text="Add New Service"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Separator/>

            <VBox spacing="5">
                <Label text="Service Name:*"/>
                <TextField fx:id="nameField" promptText="Enter service name"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Category:*"/>
                <ComboBox fx:id="categoryBox" promptText="Select category" maxWidth="Infinity" editable="true"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Price (₸):*"/>
                <TextField fx:id="priceField" promptText="0.00"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Duration (minutes):*"/>
                <Spinner fx:id="durationSpinner" editable="true" prefWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Status:"/>
                <ComboBox fx:id="statusBox" maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <VBox spacing="10">
                <Button fx:id="saveButton" text="Save Service" onAction="#onSave"
                        maxWidth="Infinity"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"
                        defaultButton="true"/>

                <Button text="Clear Form" onAction="#onClear"
                        maxWidth="Infinity"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-padding: 8;"/>

                <Separator/>

                <Button text="Edit Selected" onAction="#onEdit"
                        maxWidth="Infinity"
                        style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-padding: 8;"/>

                <Button text="Deactivate Selected" onAction="#onDeactivate"
                        maxWidth="Infinity"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 8;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="* Required fields" style="-fx-font-size: 11px; -fx-text-fill: #6c757d;"/>

        </VBox>
    </right>

</BorderPane>