<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.EmployeesController"
            prefHeight="700" prefWidth="1100"
            style="-fx-background-color: #FAFAFA;">

    <!-- TOP: Search Panel with Modern Card Design -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(111,66,193,0.08), 12, 0, 0, 2);">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <!-- Search Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Search Employees" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Action Buttons Group -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Edit" onAction="#onEdit"
                            style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: 500;">
                        <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                    </Button>
                    <Button text="Deactivate" onAction="#onDeactivate"
                            style="-fx-background-color: #EDE9FE; -fx-text-fill: #7C3AED; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: 500;">
                        <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                    </Button>
                </HBox>
            </HBox>

            <VBox.margin>
                <Insets bottom="16"/>
            </VBox.margin>

            <!-- Search Fields -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Name" style="-fx-font-size: 12px; -fx-text-fill: #6B7280; -fx-font-weight: 500;"/>
                    <TextField fx:id="searchField" promptText="Enter employee name"
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 13px; -fx-prompt-text-fill: #9CA3AF;"/>
                </VBox>

                <VBox spacing="6" prefWidth="180">
                    <Label text="Position" style="-fx-font-size: 12px; -fx-text-fill: #6B7280; -fx-font-weight: 500;"/>
                    <ComboBox fx:id="positionFilter" promptText="All positions" prefWidth="180" maxWidth="180" minWidth="180"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                </VBox>

                <VBox spacing="6" prefWidth="120">
                    <Label text="Status" style="-fx-font-size: 12px; -fx-text-fill: #6B7280; -fx-font-weight: 500;"/>
                    <ComboBox fx:id="statusFilter" promptText="All" prefWidth="120" maxWidth="120" minWidth="120"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text=" " style="-fx-font-size: 12px;"/>
                    <HBox spacing="10">
                        <Button text="Search" onAction="#onSearch"
                                style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 24; -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: 600;">
                            <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                        </Button>
                        <Button text="Reset" onAction="#onReset"
                                style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 10 20; -fx-font-size: 13px; -fx-cursor: hand;">
                            <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Employee List with Modern Cards -->
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- List Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Employees List" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;"/>
                <VBox.margin>
                    <Insets bottom="12"/>
                </VBox.margin>
            </HBox>

            <!-- List View -->
            <ListView fx:id="employeesListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-border-width: 0;"/>
        </VBox>
    </center>

    <!-- RIGHT: Add/Edit Form Panel -->
    <right>
        <VBox spacing="0" prefWidth="360"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(111,66,193,0.08), 12, 0, -2, 0);">

            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <!-- Form Header -->
            <VBox spacing="8">
                <Label fx:id="formTitle" text="Add New Employee"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;"/>
                <Label text="Fill in the employee information below"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                <VBox.margin>
                    <Insets bottom="24"/>
                </VBox.margin>
            </VBox>

            <!-- Separator Line -->
            <Separator style="-fx-background-color: #F3F4F6; -fx-padding: 0;">
                <VBox.margin>
                    <Insets bottom="24"/>
                </VBox.margin>
            </Separator>

            <!-- Form Fields -->
            <VBox spacing="20" VBox.vgrow="ALWAYS">

                <!-- First Name -->
                <VBox spacing="6">
                    <Label text="First Name *" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: 600;"/>
                    <TextField fx:id="firstNameField" promptText="Enter first name"
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 12 14; -fx-font-size: 13px; -fx-prompt-text-fill: #9CA3AF;"/>
                </VBox>

                <!-- Last Name -->
                <VBox spacing="6">
                    <Label text="Last Name *" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: 600;"/>
                    <TextField fx:id="lastNameField" promptText="Enter last name"
                               style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 12 14; -fx-font-size: 13px; -fx-prompt-text-fill: #9CA3AF;"/>
                </VBox>

                <!-- Position -->
                <VBox spacing="6">
                    <Label text="Position *" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="positionBox" promptText="Select position" maxWidth="Infinity"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Status -->
                <VBox spacing="6">
                    <Label text="Status *" style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="statusBox" promptText="Select status" maxWidth="Infinity"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                </VBox>

            </VBox>

            <!-- Separator Line -->
            <Separator style="-fx-background-color: #F3F4F6; -fx-padding: 0;">
                <VBox.margin>
                    <Insets top="24" bottom="20"/>
                </VBox.margin>
            </Separator>

            <!-- Action Buttons -->
            <VBox spacing="12">
                <Button fx:id="saveButton" text="Save Employee" onAction="#onSave" maxWidth="Infinity"
                        style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 14 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: 600;">
                    <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="Clear Form" onAction="#onClear" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 12 24; -fx-font-size: 13px; -fx-cursor: hand;">
                    <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

        </VBox>
    </right>

</BorderPane>
