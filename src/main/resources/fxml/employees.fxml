<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.EmployeesController"
            prefHeight="700" prefWidth="1000">

    <!-- TOP -->
    <top>
        <HBox spacing="12" alignment="CENTER" style="-fx-background-color: #f8f6fc;">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <TextField fx:id="searchField" promptText="Search by name" prefWidth="180"/>
            <ComboBox fx:id="positionFilter" promptText="Position" prefWidth="150"/>
            <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="120"/>

            <Button text="Search" onAction="#onSearch"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>
            <Button text="Reset" onAction="#onReset"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>

            <Button text="Edit Selected" onAction="#onEdit"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>
            <Button text="Deactivate Selected" onAction="#onDeactivate"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <ListView fx:id="employeesListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <!-- RIGHT -->
    <right>
        <VBox spacing="16" prefWidth="300"
              style="-fx-background-color: #f4f2fa; -fx-padding: 20;">

            <Label fx:id="formTitle"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6f42c1;"/>

            <Separator/>

            <VBox spacing="12">
                <TextField fx:id="firstNameField" promptText="First name"
                           style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <TextField fx:id="lastNameField" promptText="Last name"
                           style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <ComboBox fx:id="positionBox" promptText="Position"
                          style="-fx-background-radius: 8;"/>
                <ComboBox fx:id="statusBox" promptText="Status"
                          style="-fx-background-radius: 8;"/>
            </VBox>

            <Separator/>

            <VBox spacing="10">
                <Button fx:id="saveButton" text="Save"
                        onAction="#onSave" maxWidth="Infinity"
                        style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>

                <Button text="Clear" onAction="#onClear"
                        maxWidth="Infinity"
                        style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
