<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.AppointmentsController"
            prefHeight="600.0" prefWidth="800.0">

    <!-- Верхняя панель: Таблица с записями -->
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="startCol" text="Start Time" prefWidth="180"/>
                <TableColumn fx:id="endCol" text="End Time" prefWidth="180"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Правая панель: Форма создания записи -->
    <right>
        <VBox spacing="15" prefWidth="280" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Create New Appointment" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Separator/>

            <VBox spacing="5">
                <Label text="Client:"/>
                <ComboBox fx:id="clientBox" promptText="Select client" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Service:"/>
                <ComboBox fx:id="serviceBox" promptText="Select service" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5" fx:id="employeeContainer">
                <Label text="Employee:"/>
                <ComboBox fx:id="employeeBox" promptText="Select employee" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Date:"/>
                <DatePicker fx:id="datePicker" promptText="Select date" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Time:"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Spinner fx:id="hourSpinner" prefWidth="70" editable="true"/>
                    <Label text=":"/>
                    <Spinner fx:id="minuteSpinner" prefWidth="70" editable="true"/>
                </HBox>
            </VBox>

            <Separator/>

            <Button text="Create Appointment" onAction="#onAdd"
                    maxWidth="Infinity"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"
                    defaultButton="true"/>

        </VBox>
    </right>

</BorderPane>