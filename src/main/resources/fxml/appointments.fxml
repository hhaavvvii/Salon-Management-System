<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.AppointmentsController"
            prefHeight="700" prefWidth="1400"
            style="-fx-background-color: #f3eefc;">

    <!-- TOP: Filters -->
    <top>
        <HBox spacing="12" alignment="CENTER"
              style="-fx-background-color: #f8f6fc;">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <DatePicker fx:id="calendarDatePicker" prefWidth="150"/>
            <TextField fx:id="searchClientField" promptText="Search by client" prefWidth="180"/>
            <ComboBox fx:id="filterEmployeeBox" promptText="All masters" prefWidth="160"/>

            <Button text="Search" onAction="#onSearch"
                    style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>
            <Button text="Reset" onAction="#onReset"
                    style="-fx-background-color: #e0d6f5; -fx-text-fill: #6f42c1;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CENTER: Calendar -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox fx:id="calendarContainer" spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>

    <!-- RIGHT: Form -->
    <right>
        <VBox spacing="16" prefWidth="300" style="-fx-background-color: #f4f2fa; -fx-padding: 20;">
            <Label text="Create Appointment"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6f42c1;"/>
            <Separator/>
            <VBox spacing="12">
                <ComboBox fx:id="clientBox" promptText="Client" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <ComboBox fx:id="serviceBox" promptText="Service" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <ComboBox fx:id="employeeBox" promptText="Employee" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <DatePicker fx:id="datePicker" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <HBox spacing="10">
                    <Spinner fx:id="hourSpinner" prefWidth="80" style="-fx-background-radius: 8;"/>
                    <Spinner fx:id="minuteSpinner" prefWidth="80" style="-fx-background-radius: 8;"/>
                </HBox>
            </VBox>
            <Separator/>
            <VBox spacing="10">
                <Button fx:id="createButton" text="Create Appointment" onAction="#onAdd" maxWidth="Infinity"
                        style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
