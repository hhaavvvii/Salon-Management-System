<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.LoginController"
            style="-fx-background-color: #f0f2f5;">

    <!-- Центральная область с формой логина -->
    <center>
        <StackPane>
            <VBox spacing="15" alignment="CENTER" maxWidth="480"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 50 60; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                <!-- Логотип и заголовок -->
                <VBox spacing="10" alignment="CENTER">
                    <!-- Круг с иконкой -->
                    <StackPane>
                        <Circle radius="50">
                            <fill>
                                <LinearGradient startX="0" startY="0" endX="1" endY="1">
                                    <stops>
                                        <Stop offset="0" color="#7c3aed"/>
                                        <Stop offset="1" color="#a855f7"/>
                                    </stops>
                                </LinearGradient>
                            </fill>
                        </Circle>
                        <Text text="✂️" style="-fx-font-size: 48px;"/>
                    </StackPane>

                    <Text text="Salon Management System"
                          style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-fill: #333333;"
                          textAlignment="CENTER"/>

                    <Text text="Sign in to your account"
                          style="-fx-font-size: 14px; -fx-fill: #666666;"/>
                </VBox>

                <!-- Выбор роли -->
                <VBox spacing="12" alignment="CENTER">
                    <Label text="Select your role"
                           style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;"/>

                    <HBox spacing="15" alignment="CENTER">
                        <!-- Кнопка ADMIN -->
                        <VBox fx:id="adminRoleBox" spacing="8" alignment="CENTER"
                              onMouseClicked="#selectAdminRole"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20 30; -fx-cursor: hand; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 2;">
                            <Text text="👨‍💼" style="-fx-font-size: 32px;"/>
                            <Label text="Administrator"
                                   style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- Кнопка MASTER -->
                        <VBox fx:id="masterRoleBox" spacing="8" alignment="CENTER"
                              onMouseClicked="#selectMasterRole"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20 30; -fx-cursor: hand; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 2;">
                            <Text text="💇" style="-fx-font-size: 32px;"/>
                            <Label text="Master"
                                   style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Поля ввода -->
                <VBox spacing="15">
                    <!-- Username -->
                    <VBox spacing="5">
                        <Label text="Username"
                               style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;"/>
                        <TextField fx:id="usernameField"
                                   promptText="Enter your username"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db; -fx-padding: 12; -fx-font-size: 14px; -fx-border-width: 1.5;"/>
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="5">
                        <Label text="Password"
                               style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Enter your password"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db; -fx-padding: 12; -fx-font-size: 14px; -fx-border-width: 1.5;"/>
                    </VBox>
                </VBox>

                <!-- Error Label -->
                <Label fx:id="errorLabel"
                       visible="false"
                       wrapText="true"
                       maxWidth="380"
                       style="-fx-text-fill: #dc3545; -fx-font-size: 13px; -fx-background-color: #f8d7da; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #f5c6cb; -fx-border-radius: 5;"/>

                <!-- Login Button -->
                <Button text="Sign In"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: linear-gradient(to right, #7c3aed, #a855f7); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

                <!-- Footer Info -->
                <VBox spacing="8" alignment="CENTER">
                    <Separator maxWidth="350"/>
                    <Label text="Default credentials:"
                           style="-fx-font-size: 11px; -fx-text-fill: #999999;"/>
                    <HBox spacing="20" alignment="CENTER">
                        <Label text="Admin: admin/admin"
                               style="-fx-font-size: 10px; -fx-text-fill: #666666;"/>
                        <Label text="Master: master1/123456"
                               style="-fx-font-size: 10px; -fx-text-fill: #666666;"/>
                    </HBox>
                </VBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
