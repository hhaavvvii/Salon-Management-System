<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.salonmanagementsystem.controllers.DashboardController"
            style="-fx-background-color: #f0f2f5;">

    <!-- Верхняя панель: Профиль пользователя (узкая) -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">

            <!-- Заголовок системы -->
            <Text text="Salon Management System"
                  style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #6b46c1;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Иконка профиля с градиентом -->
            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                <image>
                    <Image url="@../icons/logo.png"/>
                </image>
            </ImageView>

            <!-- Информация о пользователе -->
            <VBox spacing="1">
                <Label fx:id="userNameLabel" text="Loading..."
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <Label fx:id="userRoleLabel" text="Role: Loading..."
                       style="-fx-font-size: 11px; -fx-text-fill: #666666;"/>
            </VBox>
        </HBox>
    </top>

    <!-- Левая панель: Навигационное меню -->
    <left>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #6b46c1, #7c3aed); -fx-min-width: 220; -fx-max-width: 220;">

            <!-- Навигация -->
            <VBox spacing="3" style="-fx-padding: 20 10;">

                <Label text="NAVIGATION"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 5 15;"/>

                <Button fx:id="clientsButton" onAction="#openClients" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="👥" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Clients" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="employeesButton" onAction="#openEmployees" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="👨‍💼" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Employees" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="servicesButton" onAction="#openServices" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="💇" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Services" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="appointmentsButton" onAction="#openAppointments" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="📅" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Appointments" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="paymentsButton" onAction="#openPayments" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="💳" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Payments" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="reportsButton" onAction="#openReports" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-background-radius: 5;">
                    <graphic>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="📊" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-min-width: 20; -fx-alignment: CENTER;"/>
                            <Label text="Reports" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <!-- Кнопка Logout внизу -->
            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 15;">
                <Separator style="-fx-background-color: rgba(255,255,255,0.2);"/>
                <Button text="🚪  Logout"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 5;"/>
            </VBox>

        </VBox>
    </left>

    <!-- Центральная область: Контент -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <StackPane fx:id="mainContainer"
                       style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>